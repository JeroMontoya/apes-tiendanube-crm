# Llaves Oficiales de la Biblioteca de Anuncios de Meta
# Crea una cuenta en https://developers.facebook.com/
META_ACCESS_TOKEN=your_meta_access_token_here

# Llaves de Google Merchant Center
# Crea una cuenta en Google Cloud y habilita la API de Content API for Shopping
GOOGLE_MERCHANT_ID=your_merchant_id_here

# Llaves de Google Search Console
# Habilita la API de Google Search Console en Google Cloud
GOOGLE_SEARCH_CONSOLE_KEY=your_search_console_key_here

# Puerto del Servidor
PORT=3001
