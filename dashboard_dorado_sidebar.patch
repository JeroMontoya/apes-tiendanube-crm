+// Calcula variación % comparando el inicio y el final de la serie mostrada
+// (no es "vs período anterior" real, sino la tendencia dentro del rango
+// visible en el sparkline; se etiqueta como "en el período" para ser honestos
+// sobre qué se está comparando).
+function calcDelta(sparkData) {
+  if (!sparkData || sparkData.length < 2) return { percent: 0, isPositive: true };
+  const first = sparkData[0];
+  const last = sparkData[sparkData.length - 1];
+  if (!first || first === 0) {
+    return { percent: last > 0 ? 100 : 0, isPositive: last >= 0 };
+  }
+  const pct = ((last - first) / Math.abs(first)) * 100;
+  return { percent: Math.abs(pct).toFixed(1), isPositive: pct >= 0 };
+}
